{
  "version": 1,
  "groups": { "osc": "Osc", "filter": "Filter", "master": "Master", "env": "Env", "lfo": "LFO", "fx1": "Chorus", "fx2": "Reverb", "arp": "Arp", "env2": "Env 2" },
  "params": [
    { "id": "oscOn",   "name": "Oscillator on", "group": "osc", "kind": "bool", "slot": true, "default": true },
    { "id": "wtIndex", "name": "Wavetable", "group": "osc", "kind": "choice", "slot": false, "default": 0,
      "options": [ { "value": "basic", "label": "Basic Shapes" }, { "value": "saws", "label": "Analog Saws" }, { "value": "grit", "label": "Digital Grit" }, { "value": "vocal", "label": "Vocal Formant" }, { "value": "bells", "label": "Glass Bells" }, { "value": "pwm", "label": "PWM Sweep" } ] },
    { "id": "unison",  "name": "Unison", "group": "osc", "kind": "choice", "slot": true, "default": 0,
      "options": [ { "value": "1", "label": "1" }, { "value": "2", "label": "2" }, { "value": "4", "label": "4" }, { "value": "8", "label": "8" } ] },
    { "id": "oct",     "name": "Octave", "group": "osc", "kind": "int", "slot": true, "map": { "type": "linear", "min": -3, "max": 3 }, "default": 0, "unit": "OCT" },
    { "id": "semi",    "name": "Semitones", "group": "osc", "kind": "int", "slot": true, "map": { "type": "linear", "min": -12, "max": 12 }, "default": 0, "unit": "SEMI" },
    { "id": "wtpos",   "name": "Position", "group": "osc", "kind": "float", "slot": true, "map": { "type": "linear", "min": 1, "max": 64 }, "default": 0.32, "decimals": 1 },
    { "id": "warp",    "name": "Warp", "group": "osc", "kind": "float", "slot": false, "map": { "type": "linear", "min": 0, "max": 100 }, "default": 0.1, "unit": "%", "decimals": 0 },
    { "id": "detune",  "name": "Detune", "group": "osc", "kind": "float", "slot": true, "map": { "type": "linear", "min": 0, "max": 100 }, "default": 0.18, "unit": "ct", "decimals": 0 },
    { "id": "fine",    "name": "Fine", "group": "osc", "kind": "float", "slot": true, "map": { "type": "linear", "min": -100, "max": 100 }, "default": 0.5, "unit": "ct", "decimals": 0, "bipolar": true },
    { "id": "pbRange", "name": "Pitch bend range", "group": "osc", "kind": "int", "slot": true, "map": { "type": "linear", "min": 0, "max": 24 }, "default": 2, "unit": "SEMI" },
    { "id": "level",   "name": "Level", "group": "osc", "kind": "float", "slot": true, "map": { "type": "db", "min": 0, "max": 1 }, "default": 0.85, "unit": "dB", "decimals": 1 },

    { "id": "filtOn",  "name": "Filter on", "group": "filter", "kind": "bool", "slot": true, "default": true },
    { "id": "ftype",   "name": "Filter type", "group": "filter", "kind": "choice", "slot": true, "default": 0,
      "options": [ { "value": "LP", "label": "LP" }, { "value": "HP", "label": "HP" }, { "value": "BP", "label": "BP" } ] },
    { "id": "slope",   "name": "Slope", "group": "filter", "kind": "choice", "slot": true, "default": 1,
      "options": [ { "value": "12", "label": "12" }, { "value": "24", "label": "24" } ] },
    { "id": "cutoff",  "name": "Cutoff", "group": "filter", "kind": "float", "slot": true, "map": { "type": "log", "min": 20, "max": 20000 }, "default": 0.62, "unit": "Hz", "decimals": 0, "labelKind": "hz" },
    { "id": "res",     "name": "Resonance", "group": "filter", "kind": "float", "slot": true, "map": { "type": "linear", "min": 0, "max": 100 }, "default": 0.3, "unit": "%", "decimals": 0 },
    { "id": "drive",   "name": "Drive", "group": "filter", "kind": "float", "slot": true, "map": { "type": "ms-squared", "min": 0, "max": 24 }, "default": 0, "unit": "dB", "decimals": 1 },
    { "id": "keytrk",  "name": "Key trk", "group": "filter", "kind": "float", "slot": true, "map": { "type": "linear", "min": 0, "max": 100 }, "default": 0.5, "unit": "%", "decimals": 0 },

    { "id": "voiceMode", "name": "Voice mode", "group": "master", "kind": "choice", "slot": true, "default": 0,
      "options": [ { "value": "Poly", "label": "Poly" }, { "value": "Mono", "label": "Mono" }, { "value": "Legato", "label": "Legato" } ] },
    { "id": "pan",     "name": "Pan", "group": "master", "kind": "float", "slot": true, "map": { "type": "linear", "min": -50, "max": 50 }, "default": 0.5, "decimals": 0, "labelKind": "pan", "bipolar": true },
    { "id": "glide",   "name": "Glide", "group": "master", "kind": "float", "slot": true, "map": { "type": "ms-squared", "min": 0, "max": 2000 }, "default": 0, "unit": "ms/oct", "decimals": 0 },
    { "id": "volume",  "name": "Volume", "group": "master", "kind": "float", "slot": false, "map": { "type": "db", "min": 0, "max": 1 }, "default": 0.8, "unit": "dB", "decimals": 1 },
    { "id": "bypass",  "name": "Bypass", "group": "master", "kind": "bool", "slot": true, "default": false },

    { "id": "att",     "name": "Attack", "group": "env", "kind": "float", "slot": true, "map": { "type": "ms-squared", "min": 1, "max": 8001 }, "default": 0.12, "labelKind": "time" },
    { "id": "dec",     "name": "Decay", "group": "env", "kind": "float", "slot": true, "map": { "type": "ms-squared", "min": 1, "max": 8001 }, "default": 0.4, "labelKind": "time" },
    { "id": "sus",     "name": "Sustain", "group": "env", "kind": "float", "slot": true, "map": { "type": "linear", "min": 0, "max": 100 }, "default": 0.7, "unit": "%", "decimals": 0 },
    { "id": "rel",     "name": "Release", "group": "env", "kind": "float", "slot": true, "map": { "type": "ms-squared", "min": 1, "max": 8001 }, "default": 0.35, "labelKind": "time" },
    { "id": "envVel",  "name": "Vel → amp", "group": "env", "kind": "float", "slot": true, "map": { "type": "linear", "min": 0, "max": 100 }, "default": 0.6, "unit": "%", "decimals": 0 },
    { "id": "envCurve","name": "Curve", "group": "env", "kind": "float", "slot": false, "map": { "type": "linear", "min": -100, "max": 100 }, "default": 0.5, "decimals": 0, "labelKind": "signed", "bipolar": true },

    { "id": "lshape",  "name": "LFO shape", "group": "lfo", "kind": "choice", "slot": true, "default": 0,
      "options": [ { "value": "Sine", "label": "Sine" }, { "value": "Tri", "label": "Tri" }, { "value": "Saw", "label": "Saw" }, { "value": "Square", "label": "Square" }, { "value": "S&H", "label": "S&H" } ] },
    { "id": "lsync",   "name": "LFO sync", "group": "lfo", "kind": "bool", "slot": true, "default": false },
    { "id": "lretrig", "name": "LFO retrig", "group": "lfo", "kind": "bool", "slot": true, "default": true },
    { "id": "lrate",   "name": "Rate", "group": "lfo", "kind": "float", "slot": true, "map": { "type": "log", "min": 0.05, "max": 20 }, "default": 0.45, "unit": "Hz", "decimals": 2 },
    { "id": "lphase",  "name": "Phase", "group": "lfo", "kind": "float", "slot": true, "map": { "type": "linear", "min": 0, "max": 360 }, "default": 0, "unit": "°", "decimals": 0 },
    { "id": "lfade",   "name": "Fade in", "group": "lfo", "kind": "float", "slot": true, "map": { "type": "linear", "min": 0, "max": 4000 }, "default": 0, "unit": "ms", "decimals": 0 },

    { "id": "fx1On",   "name": "Chorus on", "group": "fx1", "kind": "bool", "slot": true, "default": true },
    { "id": "chRate",  "name": "Rate", "group": "fx1", "kind": "float", "slot": true, "map": { "type": "linear", "min": 0.1, "max": 5.1 }, "default": 0.3, "unit": "Hz", "decimals": 2 },
    { "id": "chDepth", "name": "Depth", "group": "fx1", "kind": "float", "slot": true, "map": { "type": "linear", "min": 0, "max": 100 }, "default": 0.4, "unit": "%", "decimals": 0 },
    { "id": "chMix",   "name": "Mix", "group": "fx1", "kind": "float", "slot": true, "map": { "type": "linear", "min": 0, "max": 100 }, "default": 0.3, "unit": "%", "decimals": 0 },
    { "id": "fx2On",   "name": "Reverb on", "group": "fx2", "kind": "bool", "slot": true, "default": true },
    { "id": "rvSize",  "name": "Size", "group": "fx2", "kind": "float", "slot": true, "map": { "type": "linear", "min": 0, "max": 100 }, "default": 0.6, "unit": "%", "decimals": 0 },
    { "id": "rvDamp",  "name": "Damp", "group": "fx2", "kind": "float", "slot": true, "map": { "type": "linear", "min": 0, "max": 100 }, "default": 0.4, "unit": "%", "decimals": 0 },
    { "id": "rvMix",   "name": "Mix", "group": "fx2", "kind": "float", "slot": true, "map": { "type": "linear", "min": 0, "max": 100 }, "default": 0.25, "unit": "%", "decimals": 0 },

    { "id": "arpOn",   "name": "Arp on", "group": "arp", "kind": "bool", "slot": true, "default": false },
    { "id": "arpMode", "name": "Arp mode", "group": "arp", "kind": "choice", "slot": true, "default": 0,
      "options": [ { "value": "Up", "label": "Up" }, { "value": "Down", "label": "Down" }, { "value": "UpDn", "label": "UpDn" }, { "value": "Rand", "label": "Rand" } ] },
    { "id": "arpRate", "name": "Rate", "group": "arp", "kind": "float", "slot": true, "map": { "type": "linear", "min": 0, "max": 1 }, "default": 0.4, "labelKind": "arp-rate" },
    { "id": "arpGate", "name": "Gate", "group": "arp", "kind": "float", "slot": true, "map": { "type": "linear", "min": 0, "max": 100 }, "default": 0.6, "unit": "%", "decimals": 0 },
    { "id": "arpOct",  "name": "Octaves", "group": "arp", "kind": "float", "slot": true, "map": { "type": "linear", "min": 1, "max": 4 }, "default": 0.33, "decimals": 0 },
    { "id": "arpSwing","name": "Swing", "group": "arp", "kind": "float", "slot": true, "map": { "type": "linear", "min": 0, "max": 100 }, "default": 0, "unit": "%", "decimals": 0 },

    { "id": "att2",    "name": "Attack", "group": "env2", "kind": "float", "slot": true, "map": { "type": "ms-squared", "min": 1, "max": 8001 }, "default": 0.12, "labelKind": "time" },
    { "id": "dec2",    "name": "Decay", "group": "env2", "kind": "float", "slot": true, "map": { "type": "ms-squared", "min": 1, "max": 8001 }, "default": 0.4, "labelKind": "time" },
    { "id": "sus2",    "name": "Sustain", "group": "env2", "kind": "float", "slot": true, "map": { "type": "linear", "min": 0, "max": 100 }, "default": 0.7, "unit": "%", "decimals": 0 },
    { "id": "rel2",    "name": "Release", "group": "env2", "kind": "float", "slot": true, "map": { "type": "ms-squared", "min": 1, "max": 8001 }, "default": 0.35, "labelKind": "time" },

    { "id": "chFeedback", "name": "Feedback", "group": "fx1", "kind": "float", "slot": true, "map": { "type": "linear", "min": 0, "max": 100 }, "default": 0, "unit": "%", "decimals": 0 },

    { "id": "rvPredelay", "name": "Predelay", "group": "fx2", "kind": "float", "slot": true, "map": { "type": "linear", "min": 0, "max": 100 }, "default": 0.2, "unit": "ms", "decimals": 0 },
    { "id": "rvDecay",  "name": "Decay", "group": "fx2", "kind": "float", "slot": true, "map": { "type": "linear", "min": 0, "max": 100 }, "default": 0.5, "unit": "%", "decimals": 0 }
  ]
}
