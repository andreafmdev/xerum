{
  "name": "serum-style-synth-webui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "ui:build": "pnpm --filter @xerum/ui build",
    "ui:test": "pnpm --filter @xerum/ui test",
    "ui:storybook": "pnpm --filter @xerum/ui storybook",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "gen:params": "node ../scripts/gen-params.mjs"
  },
  "dependencies": {
    "@juce-framework/webview": "link:../external/JUCE/modules/juce_gui_extra/native/typescript/webview-interop",
    "@xerum/ui": "workspace:*",
    "lucide-react": "^1.46.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^30.1.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.0",
    "vitest": "^5.0.1"
  }
}
