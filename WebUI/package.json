    "ui:storybook": "pnpm --filter @xerum/ui storybook"
  },
  "dependencies": {
    "@xerum/ui": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.7.2",
    "vite": "^6.0.0"
  }
}
